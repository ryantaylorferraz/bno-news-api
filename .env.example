# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3333
NODE_ENV=development
LOG_LEVEL=info

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Supabase > Settings > Database > Connection string
#
# DATABASE_URL  → "Transaction" pooler (porta 6543) — usado pelo Prisma em runtime
# DIRECT_URL    → "Session" mode / direct connection (porta 5432) — usado pelo Prisma Migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Em produção, substituir pelo domínio real do frontend
CORS_ORIGIN=http://localhost:3000

# ── Auth (a configurar) ───────────────────────────────────────────────────────
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# ── Supabase Storage (a configurar) ───────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── E-mail (Nodemailer SMTP) ──────────────────────────────────────────────────
# Preencha para ativar notificações de nova pauta.
# Deixe em branco para desativar (sem erro, apenas sem envio).
#
# Gmail: SMTP_HOST=smtp.gmail.com | SMTP_PORT=587
#   → use uma "Senha de app" (não a senha normal da conta):
#   → https://myaccount.google.com/apppasswords
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=sua_senha_de_app
# MAIL_FROM=seuemail@gmail.com
# MAIL_TO=redacao@bno.com.br
# FRONTEND_URL=https://seu-site.vercel.app
